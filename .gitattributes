# The Maven wrapper ships both flavours; each must keep its own endings
# regardless of the cloning platform. mvnw is a /bin/sh script and breaks
# outright if it is checked out with CRLF.
mvnw       text eol=lf
mvnw.cmd   text eol=crlf

# The publication fixtures are hashed byte-for-byte by hashes.txt, and the
# capture script writes LF. A CRLF checkout changes every hash and fires the
# drift guard on a clean clone -- a false alarm that would teach people to
# regenerate on sight, which is exactly what the guard exists to prevent.
*.mjs                                          text eol=lf
niord-core/src/test/resources/fixtures/**      text eol=lf

# The schema baseline is compared byte-for-byte to detect drift, and regeneration
# is deterministic. A CRLF checkout would make every comparison fail.
niord-core/src/test/resources/schema/**        text eol=lf

# The rule-id export carries a SHA-256 of its source section in the header and is
# compared byte-for-byte. CRLF would break that comparison on Windows.
niord-core/src/test/resources/rule-ids.txt     text eol=lf
